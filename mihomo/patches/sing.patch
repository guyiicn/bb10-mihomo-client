diff --color -ruN a/common/bufio/vectorised_qnx.go b/common/bufio/vectorised_qnx.go
--- a/common/bufio/vectorised_qnx.go	1970-01-01 08:00:00.000000000 +0800
+++ b/common/bufio/vectorised_qnx.go	2026-11-16 08:24:50.782669265 +0800
@@ -0,0 +1,23 @@
+//go:build qnx
+package bufio
+import (
+ "errors"
+ "io"
+ "os"
+ "sync"
+ "github.com/metacubex/sing/common/buf"
+ M "github.com/metacubex/sing/common/metadata"
+ "golang.org/x/sys/unix"
+)
+type syscallVectorisedWriterFields struct { access sync.Mutex }
+func (w *SyscallVectorisedWriter) WriteVectorised(buffers []*buf.Buffer) error {
+ w.access.Lock(); defer w.access.Unlock(); defer buf.ReleaseMulti(buffers)
+ data := make([]byte,buf.LenMulti(buffers)); if len(data)==0 {return os.ErrInvalid}; buf.CopyMulti(data,buffers)
+ var inner error
+ err:=w.rawConn.Write(func(fd uintptr) bool { for len(data)>0 { n,e:=unix.Write(int(fd),data); if n>0 {data=data[n:]}; if e==unix.EINTR {continue}; if e==unix.EAGAIN {return false}; if e!=nil {inner=e; return true}; if n==0 {inner=io.ErrNoProgress; return true} }; return true })
+ if err!=nil{return err}; return inner
+}
+func (w *SyscallVectorisedPacketWriter) WriteVectorisedPacket(buffers []*buf.Buffer, destination M.Socksaddr) error {
+ defer buf.ReleaseMulti(buffers)
+ return errors.New("QNX vectorised UDP writer not implemented")
+}
