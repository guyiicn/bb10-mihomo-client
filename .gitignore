# ---- Build artifacts ----
build/
bin/
*.bar
*.o
*.obj
tools/configtool/configtool

# Prebuilt QNX cross-compiled binaries (rebuilt by scripts/)
*-qnx-arm
*-qnx-arm-v2

# ---- Large public geo databases (fetch via scripts/fetch-geodata.sh) ----
app/assets/geoip.metadb
app/assets/geosite.dat

# ---- Credentials — NEVER commit node configs / subscriptions ----
# Imported subscriptions and generated core configs carry node addresses,
# passwords and keys. They are runtime data, not source.
active.yaml
active.yaml.new
source.yaml
import.yaml
data/proxy/
**/node-config-out/
*.subscription.yaml

# ---- Reproducible-deps work area (fetched upstream, not committed) ----
# scripts/apply-patches.sh fetches upstream mihomo + overrides here and applies
# mihomo/patches/. The fetched tree is large GPL source; only our patches live in git.
mihomo/upstream/
mihomo/overrides-upstream/

# ---- OS / editor cruft ----
.DS_Store
*.swp

# Generated by build-core.sh (absolute mihomo path)
core/go.work

# ---- Internal planning (local env / ops notes, not for public repo) ----
docs/REFACTOR-PLAN.md
