@@ -0,0 +1,39 @@
+//go:build qnx && bb10_real_tun
+
+package tun
+
+import (
+	"os"
+
+	"local/bb10-qnx-tun-lab/backend"
+)
+
+// New is the experimental BB10 entry point. It exists only in builds made
+// with -tags bb10_real_tun from the qnx-tun-lab Go workspace, and refuses to
+// run unless BB10_TUN_EXPERIMENT=1. It opens /dev/<Name> in raw IPv4 mode and
+// does nothing else: the interface address and every route are the caller's
+// responsibility, and any option that would need them is rejected.
+func New(options Options) (Tun, error) {
+	request := backend.Request{
+		Name:                 options.Name,
+		MTU:                  options.MTU,
+		AutoRoute:            options.AutoRoute,
+		StrictRoute:          options.StrictRoute,
+		GSO:                  options.GSO,
+		AutoRedirectMarkMode: options.AutoRedirectMarkMode,
+		FileDescriptor:       options.FileDescriptor,
+		Inet6Addresses:       len(options.Inet6Address),
+		RouteEntries: len(options.Inet4RouteAddress) + len(options.Inet6RouteAddress) +
+			len(options.Inet4RouteExcludeAddress) + len(options.Inet6RouteExcludeAddress) +
+			len(options.IncludeInterface) + len(options.ExcludeInterface) +
+			len(options.IncludeUID) + len(options.ExcludeUID) +
+			len(options.ExcludeSrcPort) + len(options.ExcludeDstPort) +
+			len(options.IncludeAndroidUser) + len(options.IncludePackage) + len(options.ExcludePackage) +
+			len(options.IncludeMACAddress) + len(options.ExcludeMACAddress),
+	}
+	config, err := request.Config(os.Getenv)
+	if err != nil {
+		return nil, err
+	}
+	return backend.OpenReal(config)
+}
