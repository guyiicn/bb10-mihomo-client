diff --color -ruN pa/dns/packetconn_qnx.go pb/dns/packetconn_qnx.go
--- pa/dns/packetconn_qnx.go	1970-01-01 08:00:00.000000000 +0800
+++ pb/dns/packetconn_qnx.go	2026-11-16 08:42:31.331017525 +0800
@@ -0,0 +1,16 @@
+//go:build qnx
+
+package dns
+
+import "net"
+
+// plainPacketConn hides *net.UDPConn from miekg/dns. For a *net.UDPConn the
+// library first enables IP_PKTINFO-style control messages through
+// golang.org/x/net/ipv4 and ipv6, which are stubs on QNX and return "not
+// implemented"; ActivateAndServe then returns before reading a single packet
+// while the socket stays bound, so every UDP query times out. With a plain
+// net.PacketConn the library uses ReadFrom/WriteTo and needs no control
+// messages. The reply source address is then chosen by the routing table.
+type plainPacketConn struct{ net.PacketConn }
+
+func servePacketConn(p net.PacketConn) net.PacketConn { return plainPacketConn{p} }
diff --color -ruN pa/dns/server.go pb/dns/server.go
--- pa/dns/server.go	2026-11-16 08:42:31.307783058 +0800
+++ pb/dns/server.go	2026-11-16 08:42:31.330857396 +0800
@@ -111,8 +111,10 @@
 		}
 
 		log.Infoln("DNS server(UDP) listening at: %s", p.LocalAddr().String())
-		server.udpServer = &D.Server{Addr: addr, PacketConn: p, Handler: server.UDPHandler()}
-		_ = server.udpServer.ActivateAndServe()
+		server.udpServer = &D.Server{Addr: addr, PacketConn: servePacketConn(p), Handler: server.UDPHandler()}
+		if err := server.udpServer.ActivateAndServe(); err != nil {
+			log.Errorln("DNS server(UDP) stopped: %s", err.Error())
+		}
 	}()
 
 	go func() {
